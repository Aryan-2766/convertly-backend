# Example environment setup for Aiven Cloud MySQL
# Copy or rename to application.properties and supply your Aiven credentials
spring.application.name=convertly-backend
server.port=8080

# Replace with your Aiven service details:
DB_HOST=mysql-your-project-id.aivencloud.com
DB_PORT=your-port
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password

spring.datasource.url=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslMode=REQUIRED&allowPublicKeyRetrieval=true
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=100MB
